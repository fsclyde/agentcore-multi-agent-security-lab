        <mxCell id="gw" value="&lt;b&gt;AgentCore Gateway: four questions on every tool call&lt;/b&gt;&lt;br&gt;① Which agent? &lt;small&gt;(its IAM role)&lt;/small&gt;   ② For which person? &lt;small&gt;(their Cognito token)&lt;/small&gt;&lt;br&gt;③ Is it allowed? &lt;small&gt;(Cedar rules + the approval)&lt;/small&gt;   ④ Is the result safe? &lt;small&gt;(guardrail)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="810" height="100" as="geometry"/></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Kubernetes MCP server&lt;/b&gt;&lt;br&gt;&lt;small&gt;read-only · namespace demo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="lam" value="&lt;b&gt;Write tool (Lambda)&lt;/b&gt;&lt;br&gt;&lt;small&gt;one image · one change at a time&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="200" height="60" as="geometry"/></mxCell>
