        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="How a fix reaches the cluster: two agents, two people, one gateway" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="810" height="35" as="geometry"/></mxCell>
        <mxCell id="nadia" value="&lt;b&gt;nadia&lt;/b&gt;&lt;br&gt;&lt;small&gt;sre-viewer · asks why&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="110" y="60" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="marco" value="&lt;b&gt;marco&lt;/b&gt;&lt;br&gt;&lt;small&gt;sre-admin · asks for the fix&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="190" height="60" as="geometry"/></mxCell>
